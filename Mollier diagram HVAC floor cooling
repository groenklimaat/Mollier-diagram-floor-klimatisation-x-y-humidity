# DHT22 / ARDUINO SERIAL READER
# ============================================================
class DHT22Reader:
    """Leest DHT22 via seriële poort. Kan ook commando's sturen naar Arduino."""

    def __init__(self):
        self.serial_conn = None
        self.running = False
        self.thread = None
        self.callback = None

    @staticmethod
    def list_ports():
        if not SERIAL_AVAILABLE:
            return []
        return [p.device for p in serial.tools.list_ports.comports()]

    def connect(self, port, baudrate=9600):
        if not SERIAL_AVAILABLE:
            raise Exception("pyserial niet geïnstalleerd")
        self.serial_conn = serial.Serial(port, baudrate, timeout=1)
        time.sleep(2)
        return True

    def disconnect(self):
        self.running = False
        if self.thread and self.thread.is_alive():
            self.thread.join(timeout=2)
        if self.serial_conn and self.serial_conn.is_open:
            self.serial_conn.close()
        self.serial_conn = None

    def start_reading(self, callback):
        if not self.serial_conn:
            raise Exception("Geen seriële verbinding")
        self.callback = callback
        self.running = True
        self.thread = threading.Thread(target=self._read_loop, daemon=True)
        self.thread.start()

    def _read_loop(self):
        while self.running:
            try:
                if self.serial_conn.in_waiting > 0:
                    line = self.serial_conn.readline().decode('utf-8', errors='ignore').strip()
                    if line:
                        parts = line.replace(';', ',').split(',')
                        if len(parts) >= 2:
                            try:
                                T = float(parts[0])
                                phi = float(parts[1])
                                if self.callback:
                                    self.callback(T, phi)
                            except ValueError:
                                pass
            except Exception:
                pass
            time.sleep(0.1)

    def send_command(self, cmd):
        """Stuur een commando-regel naar de Arduino."""
        if not self.serial_conn or not self.serial_conn.is_open:
            return False
        try:
            if not cmd.endswith('\n'):
                cmd += '\n'
            self.serial_conn.write(cmd.encode('utf-8'))
            return True
        except Exception as e:
            print(f"Send error: {e}")
            return False


