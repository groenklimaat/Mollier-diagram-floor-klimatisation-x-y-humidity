    def refresh_ports(self):
        if not SERIAL_AVAILABLE:
            messagebox.showwarning("pyserial niet gevonden",
                                   "Installeer pyserial:\n\npip install pyserial")
            return
        ports = DHT22Reader.list_ports()
        self.port_in_combo['values'] = ports
        self.port_out_combo['values'] = ports
        self.arduino_port_combo['values'] = ports
        if len(ports) >= 1 and not self.port_in_var.get():
            self.port_in_var.set(ports[0])
        if len(ports) >= 2 and not self.port_out_var.get():
            self.port_out_var.set(ports[1])
        if len(ports) >= 1 and not self.arduino_port_var.get():
            self.arduino_port_var.set(ports[0])
        self.status_var.set(f"{len(ports)} poort(en) gevonden")

    def toggle_connection(self, locatie):
        if locatie == 'binnen':
            if self.dht_binnen_connected:
                self.dht_binnen.disconnect()
                self.dht_binnen_connected = False
                self.connect_in_btn.config(text="VERBIND BINNEN", bg='#00695C')
                self.status_in_var.set("Binnen niet verbonden")
            else:
                self._connect(locatie)
        else:
            if self.dht_buiten_connected:
                self.dht_buiten.disconnect()
                self.dht_buiten_connected = False
                self.connect_out_btn.config(text="VERBIND BUITEN", bg='#00695C')
                self.status_out_var.set("Buiten niet verbonden")
            else:
                self._connect(locatie)

    def _connect(self, locatie):
        if not SERIAL_AVAILABLE:
            messagebox.showerror("Fout", "pyserial niet geïnstalleerd.\n\npip install pyserial")
            return
        port = self.port_in_var.get() if locatie == 'binnen' else self.port_out_var.get()
        if not port:
            messagebox.showwarning("Geen poort", f"Selecteer poort voor {locatie}.")
            return
        try:
            if locatie == 'binnen':
                self.dht_binnen.connect(port)
                self.dht_binnen_connected = True
                self.connect_in_btn.config(text="VERBREEK BINNEN", bg='#c62828')
                self.status_in_var.set(f"Binnen: {port}")
                self.dht_binnen.start_reading(self.on_dht_binnen)
            else:
                self.dht_buiten.connect(port)
                self.dht_buiten_connected = True
                self.connect_out_btn.config(text="VERBREEK BUITEN", bg='#c62828')
                self.status_out_var.set(f"Buiten: {port}")
                self.dht_buiten.start_reading(self.on_dht_buiten)
            self.status_var.set(f"{locatie.capitalize()} verbonden op {port}")
        except Exception as e:
            messagebox.showerror("Verbindingsfout", f"Kon niet verbinden:\n{str(e)}")

    def on_dht_binnen(self, T, phi):
        self.root.after(0, lambda: self._update_dht_in(T, phi))

    def on_dht_buiten(self, T, phi):
        self.root.after(0, lambda: self._update_dht_out(T, phi))

    def _update_dht_in(self, T, phi):
        self.dht_in_temp.set(f"{T:.1f}")
        self.dht_in_phi.set(f"{phi:.0f}")
        if self.regel_modus.get() == 'arduino':
            self.temp_in_var.set(f"{T:.1f}")
            self.phi_in_var.set(f"{phi:.0f}")

    def _update_dht_out(self, T, phi):
        self.dht_out_temp.set(f"{T:.1f}")
        self.dht_out_phi.set(f"{phi:.0f}")
        if self.regel_modus.get() == 'arduino':
            self.temp_out_var.set(f"{T:.1f}")
            self.phi_out_var.set(f"{phi:.0f}")

    # --------------------------------------------------------
    # Vloerkoeling
    # --------------------------------------------------------
    def update_regel_modus(self):
        modus = self.regel_modus.get()
        if modus == 'manueel':
            if self.arduino_ser and self.arduino_ser.is_open:
                self.arduino_ser.close()
            self.arduino_ser = None
            self.arduino_connect_btn.config(text="Verbind", bg='#00695C')
            self.status_var.set("Manuele modus: waarden worden gebruikt voor berekening")
        else:
            self.status_var.set("Arduino modus: sensorwaarden komen van Arduino")
        self.toon_waarden()

    def toggle_arduino(self):
        if self.arduino_ser and self.arduino_ser.is_open:
            self.arduino_ser.close()
            self.arduino_ser = None
            self.arduino_connect_btn.config(text="Verbind", bg='#00695C')
            self.status_var.set("Arduino regeling verbroken")
            return
        if not SERIAL_AVAILABLE:
            messagebox.showerror("Fout", "pyserial niet geïnstalleerd")
            return
        port = self.arduino_port_var.get()
        if not port:
            messagebox.showwarning("Geen poort", "Selecteer een Arduino poort.")
            return
        try:
            self.arduino_ser = serial.Serial(port, 9600, timeout=1)
            time.sleep(2)
            self.arduino_connect_btn.config(text="Verbreek", bg='#c62828')
            self.status_var.set(f"Arduino regeling verbonden op {port}")
        except Exception as e:
            messagebox.showerror("Fout", f"Kon Arduino niet verbinden:\n{e}")

    def update_vloerkoeling(self, T_in, phi_in, T_out, phi_out):
        resultaat = self.vloerkoeling.bereken(T_in, phi_in, T_out, phi_out)
        self.vloerkoeling_resultaat = resultaat

        if self.override_var.get():
            resultaat['aan'] = True
            if resultaat['aanvoer_temp'] is None:
                T_dauw = resultaat.get('dauwpunt_binnen')
                resultaat['aanvoer_temp'] = (T_dauw + 1.5 - 2.0) if T_dauw else 12.0
            resultaat['reden'] = "HANDMATIG GEFORCEERD AAN"

        if resultaat['aan']:
            self.vk_status_var.set(
                f"VLOERKOELING AAN\n"
                f"   Aanvoertemperatuur: {resultaat['aanvoer_temp']:.1f} C"
            )
            self.vk_status_label.config(fg='#00ff88')
        else:
            self.vk_status_var.set("VLOERKOELING UIT")
            self.vk_status_label.config(fg='#ff6b6b')

        detail = resultaat['reden']
        if resultaat.get('dauwpunt_binnen') is not None:
            detail += f"\nDauwpunt binnen: {resultaat['dauwpunt_binnen']:.1f} C"
        if 'vloer_min' in resultaat:
            detail += f"\nMin. vloertemperatuur: {resultaat['vloer_min']:.1f} C"
        if resultaat.get('waarschuwing'):
            detail += f"\n{resultaat['waarschuwing']}"
        self.vk_detail_var.set(detail)

        if (self.regel_modus.get() == 'arduino'
                and self.arduino_ser and self.arduino_ser.is_open):
            self.vloerkoeling.stuur_arduino(self.arduino_ser, resultaat)

    def save_arduino_sketch(self):
        pad = filedialog.asksaveasfilename(
            defaultextension=".ino",
            filetypes=[("Arduino sketch", "*.ino"), ("Alle bestanden", "*.*")],
            initialfile="vloerkoeling.ino"
        )
        if pad:
            try:
                with open(pad, 'w', encoding='utf-8') as f:
                    f.write(ARDUINO_SKETCH)
                messagebox.showinfo("Opgeslagen",
                                    f"Arduino sketch opgeslagen:\n{pad}\n\n"
                                    f"Open dit bestand in de Arduino IDE.")
            except Exception as e:
                messagebox.showerror("Fout", f"Kon niet opslaan:\n{e}")

    # --------------------------------------------------------
    # Berekeningen
    # --------------------------------------------------------
    def toon_waarden(self):
        try:
            T_in = float(self.temp_in_var.get())
            phi_in = float(self.phi_in_var.get())
            T_out = float(self.temp_out_var.get())
            phi_out = float(self.phi_out_var.get())
            wind = float(self.wind_var.get())
            solar = float(self.solar_var.get())
            V_dot = float(self.flow_var.get())
            T_surf = float(self.surf_var.get())

            res_in = self.psych.alle_grootheden(T_in, phi_in, V_dot, 0, 0)
            res_out = self.psych.alle_grootheden(T_out, phi_out, V_dot, wind, solar)

            m_cond_in, T_d_in, heeft_in = self.psych.condensatie_hoeveelheid(
                V_dot, T_in, phi_in, T_surf)
            m_cond_out, T_d_out, heeft_out = self.psych.condensatie_hoeveelheid(
                V_dot, T_out, phi_out, T_surf)

            self.result_tree.delete(*self.result_tree.get_children())

            self.update_vloerkoeling(T_in, phi_in, T_out, phi_out)
            vk = self.vloerkoeling_resultaat

            rows = [
                ('--- BASISPARAMETERS ---', '', '', ''),
                ('Temperatuur', f"{T_in:.1f}", f"{T_out:.1f}", 'C'),
                ('Relatieve vochtigheid', f"{phi_in:.0f}", f"{phi_out:.0f}", '%'),
                ('Absolute vochtigheid', f"{res_in['x']:.4f}", f"{res_out['x']:.4f}", 'kg/kg'),
                ('Dichtheid', f"{res_in['rho']:.3f}", f"{res_out['rho']:.3f}", 'kg/m3'),
                ('', '', '', ''),
                ('--- PSYCHROMETRISCH ---', '', '', ''),
                ('Dauwpunt',
                 f"{res_in['T_dauw']:.1f}" if res_in['T_dauw'] else '--',
                 f"{res_out['T_dauw']:.1f}" if res_out['T_dauw'] else '--', 'C'),
                ('Natte-bol temperatuur', f"{res_in['T_wb']:.1f}",
                 f"{res_out['T_wb']:.1f}", 'C'),
                ('Enthalpie', f"{res_in['h']:.1f}", f"{res_out['h']:.1f}", 'kJ/kg'),
                ('Waterstroom', f"{res_in['m_dot_water']:.3f}",
                 f"{res_out['m_dot_water']:.3f}", 'kg/h'),
                ('', '', '', ''),
                ('--- GEVOELSTEMPERATUUR ---', '', '', ''),
                ('Gevoelstemperatuur',
                 f"{res_in['gevoel_binnen']['gevoel']:.1f}",
                 f"{res_out['gevoel_buiten']['gevoel']:.1f}", 'C'),
                ('Humidex',
                 f"{res_in['gevoel_binnen']['humidex']:.1f}",
                 f"{res_out['gevoel_buiten']['humidex']:.1f}", 'C'),
                ('Apparent Temp',
                 f"{res_in['gevoel_binnen']['apparent']:.1f}",
                 f"{res_out['gevoel_buiten']['apparent']:.1f}", 'C'),
                ('Heat Index', '--',
                 f"{res_out['gevoel_buiten']['heat_index']:.1f}", 'C'),
                ('Wind Chill', '--',
                 f"{res_out['gevoel_buiten']['wind_chill']:.1f}", 'C'),
                ('Methode', res_in['gevoel_binnen']['methode'][:20],
                 res_out['gevoel_buiten']['methode'][:20], ''),
                ('', '', '', ''),
                ('--- CONDENSATIE ---', '', '', ''),
                ('Condensatie', f"{m_cond_in:.3f}", f"{m_cond_out:.3f}", 'kg/h'),
                ('Condensatie/dag', f"{m_cond_in * 24:.2f}",
                 f"{m_cond_out * 24:.2f}", 'kg/dag'),
                ('Status', 'JA' if heeft_in else 'NEE',
                 'JA' if heeft_out else 'NEE', ''),
                ('', '', '', ''),
                ('--- VLOERKOELING ---', '', '', ''),
                ('Delta T (binnen-buiten)', f"{T_in - T_out:+.2f}", '', 'C'),
                ('Vloerkoeling',
                 'AAN' if (vk and vk['aan']) else 'UIT', '', ''),
                ('Aanvoertemperatuur',
                 f"{vk['aanvoer_temp']:.1f}"
                 if (vk and vk.get('aanvoer_temp')) else '--', '', 'C'),
                ('Dauwpunt binnen',
                 f"{vk['dauwpunt_binnen']:.1f}"
                 if (vk and vk.get('dauwpunt_binnen')) else '--', '', 'C'),
            ]

            for row in rows:
                item = self.result_tree.insert('', tk.END, values=row)
                if '---' in row[0]:
                    self.result_tree.tag_configure('header',
                                                   background='#2d1b4e',
                                                   foreground='#ffd700')
                    self.result_tree.item(item, tags=('header',))
                elif 'GEVOELSTEMPERATUUR' in row[0]:
                    self.result_tree.tag_configure('gevoel',
                                                   background='#1f3d2f',
                                                   foreground='#00ff88')
                    self.result_tree.item(item, tags=('gevoel',))
                elif 'VLOERKOELING' in row[0] or 'Aanvoer' in row[0]:
                    self.result_tree.tag_configure('vk',
                                                   background='#2a1a3a',
                                                   foreground='#00d2ff')
                    self.result_tree.item(item, tags=('vk',))

            self.update_binnen_info(res_in, T_in, phi_in)
            self.update_buiten_info(res_out, T_out, phi_out, wind, solar)

            self.status_var.set(
                f"Binnen: {T_in:.1f} C (gevoel "
                f"{res_in['gevoel_binnen']['gevoel']:.1f} C) | "
                f"Buiten: {T_out:.1f} C (gevoel "
                f"{res_out['gevoel_buiten']['gevoel']:.1f} C) | "
                f"Delta T = {T_in - T_out:+.2f} C"
            )

            self.teken_grafiek(res_in, res_out, T_in, T_out, phi_in, phi_out)

        except ValueError as e:
            messagebox.showerror("Fout", f"Voer geldige numerieke waarden in.\n{str(e)}")
        except Exception as e:
            messagebox.showerror("Fout", f"Fout: {str(e)}")

    def update_binnen_info(self, res, T, phi):
        g = res['gevoel_binnen']
        lines = [
            f"Temperatuur: {T:.1f} C",
            f"Vochtigheid: {phi:.0f}%",
            f"Dauwpunt: {g['T_dauw']:.1f} C",
            "",
            f"GEVOELSTEMPERATUUR: {g['gevoel']:.1f} C",
            f"   Humidex: {g['humidex']:.1f} C",
            f"   Apparent Temp: {g['apparent']:.1f} C",
            f"   Methode: {g['methode']}",
            "",
            "Binnenklimaat is constant:",
        ]
        if T < 18:
            lines.append("   Te koud - verhoog verwarming")
        elif T > 26:
            lines.append("   Te warm - verhoog ventilatie")
        elif 20 <= T <= 24 and 40 <= phi <= 60:
            lines.append("   Comfortabel binnenklimaat")
        else:
            lines.append("   Acceptabel binnenklimaat")
        self.binnen_status.config(text="\n".join(lines))

    def update_buiten_info(self, res, T, phi, wind, solar):
        g = res['gevoel_buiten']
        lines = [
            f"Temperatuur: {T:.1f} C",
            f"Vochtigheid: {phi:.0f}%",
            f"Dauwpunt: {g['T_dauw']:.1f} C",
            f"Wind: {wind:.0f} km/h",
            f"Zon: {solar:.0f} W/m2",
            "",
            f"GEVOELSTEMPERATUUR: {g['gevoel']:.1f} C",
            f"   Heat Index: {g['heat_index']:.1f} C",
            f"   Wind Chill: {g['wind_chill']:.1f} C",
            f"   Apparent Temp: {g['apparent']:.1f} C",
            f"   Humidex: {g['humidex']:.1f} C",
            f"   Methode: {g['methode']}",
            "",
        ]
        verschil = g['gevoel'] - T
        if verschil > 3:
            lines.append(f"Voelt {verschil:.1f} C WARMER aan")
            lines.append("   Hoge luchtvochtigheid / weinig wind")
        elif verschil < -3:
            lines.append(f"Voelt {abs(verschil):.1f} C KOUDER aan")
            lines.append("   Wind chill effect / weinig zon")
        else:
            lines.append("Voelt ongeveer hetzelfde aan")
        self.buiten_status.config(text="\n".join(lines))

    def teken_grafiek(self, res_in, res_out, T_in, T_out, phi_in, phi_out):
        self.canvas.delete("all")
        width = self.canvas.winfo_width()
        height = self.canvas.winfo_height()
        if width < 10 or height < 10:
            return

        margin = 60
        plot_width = width - 2 * margin
        plot_height = height - 2 * margin

        self.canvas.create_rectangle(0, 0, width, height, fill='#0a0a1a')
        self.canvas.create_line(margin, margin, margin, height - margin,
                                width=3, fill='#00d2ff')
        self.canvas.create_line(margin, height - margin, width - margin,
                                height - margin, width=3, fill='#00d2ff')

        self.canvas.create_text(margin - 15, height // 2, text="h (kJ/kg)",
                                angle=90, font=('Arial', 10, 'bold'),
                                fill='#00d2ff')
        self.canvas.create_text(width // 2, height - margin + 25,
                                text="Vochtgehalte x (kg/kg)",
                                font=('Arial', 10, 'bold'), fill='#00d2ff')
        self.canvas.create_text(width // 2, margin - 20,
                                text="BINNEN vs BUITEN KLIMAAT",
                                font=('Arial', 12, 'bold'), fill='#ffd700')

        x_max = 0.035
        h_max = 120
        x_scale = plot_width / x_max
        h_scale = plot_height / h_max * 0.9

        # Verzadigingslijn
        for temp in range(-10, 51, 1):
            try:
                p_sat = self.psych.p_sat(temp)
                x = self.psych.x_uit_pv(p_sat)
                h = self.psych.enthalpie(temp, x)
                if 0 <= x <= x_max and 0 <= h <= h_max and temp > -10:
                    p_sat_p = self.psych.p_sat(temp - 1)
                    x_p = self.psych.x_uit_pv(p_sat_p)
                    h_p = self.psych.enthalpie(temp - 1, x_p)
                    if 0 <= x_p <= x_max and 0 <= h_p <= h_max:
                        px1 = margin + x_p * x_scale
                        py1 = height - margin - h_p * h_scale
                        px2 = margin + x * x_scale
                        py2 = height - margin - h * h_scale
                        self.canvas.create_line(px1, py1, px2, py2,
                                                fill='#e94560', width=3)
            except Exception:
                continue

        # RH lijnen
        for phi_val in [20, 40, 60, 80]:
            for temp in range(-10, 51, 2):
                try:
                    p_sat = self.psych.p_sat(temp)
                    p_v = (phi_val / 100.0) * p_sat
                    x = self.psych.x_uit_pv(p_v)
                    h = self.psych.enthalpie(temp, x)
                    if 0 <= x <= x_max and 0 <= h <= h_max:
                        p_sat_p = self.psych.p_sat(temp - 2)
                        p_v_p = (phi_val / 100.0) * p_sat_p
                        x_p = self.psych.x_uit_pv(p_v_p)
                        h_p = self.psych.enthalpie(temp - 2, x_p)
                        if 0 <= x_p <= x_max and 0 <= h_p <= h_max:
                            px1 = margin + x_p * x_scale
                            py1 = height - margin - h_p * h_scale
                            px2 = margin + x * x_scale
                            py2 = height - margin - h * h_scale
                            self.canvas.create_line(px1, py1, px2, py2,
                                                    fill='#3498db', width=1,
                                                    dash=(3, 3))
                except Exception:
                    continue

        # Binnen punt
        if 0 <= res_in['x'] <= x_max and 0 <= res_in['h'] <= h_max:
            px = margin + res_in['x'] * x_scale
            py = height - margin - res_in['h'] * h_scale
            self.canvas.create_oval(px - 10, py - 10, px + 10, py + 10,
                                    fill='#00ff88', outline='white', width=2)
            self.canvas.create_rectangle(px + 15, py - 40, px + 175, py + 10,
                                         fill='#1a3a2e', outline='#00ff88')
            self.canvas.create_text(
                px + 20, py - 35,
                text=f"BINNEN\n{res_in['T']:.1f} C, RH={res_in['phi']:.0f}%\n"
                     f"Gevoel: {res_in['gevoel_binnen']['gevoel']:.1f} C",
                anchor='w', font=('Arial', 8), fill='#00ff88')

        # Buiten punt
        if 0 <= res_out['x'] <= x_max and 0 <= res_out['h'] <= h_max:
            px = margin + res_out['x'] * x_scale
            py = height - margin - res_out['h'] * h_scale
            self.canvas.create_oval(px - 10, py - 10, px + 10, py + 10,
                                    fill='#FFD54F', outline='white', width=2)
            self.canvas.create_rectangle(px + 15, py - 40, px + 185, py + 10,
                                         fill='#3a2e1a', outline='#FFD54F')
            self.canvas.create_text(
                px + 20, py - 35,
                text=f"BUITEN\n{res_out['T']:.1f} C, RH={res_out['phi']:.0f}%\n"
                     f"Gevoel: {res_out['gevoel_buiten']['gevoel']:.1f} C",
                anchor='w', font=('Arial', 8), fill='#FFD54F')

        # Verbindingslijn
        if (0 <= res_in['x'] <= x_max and 0 <= res_in['h'] <= h_max and
                0 <= res_out['x'] <= x_max and 0 <= res_out['h'] <= h_max):
            px1 = margin + res_in['x'] * x_scale
            py1 = height - margin - res_in['h'] * h_scale
            px2 = margin + res_out['x'] * x_scale
            py2 = height - margin - res_out['h'] * h_scale
            self.canvas.create_line(px1, py1, px2, py2, fill='#ff6bff',
                                    width=2, dash=(6, 4))

        # Legenda
        lx, ly = margin + 10, margin + 10
        self.canvas.create_rectangle(lx, ly, lx + 200, ly + 80,
                                     fill='#1a1a2e', outline='#00d2ff')
        self.canvas.create_text(lx + 10, ly + 15, text="LEGENDA", anchor='w',
                                font=('Arial', 9, 'bold'), fill='#ffd700')

        self.canvas.create_oval(lx + 10, ly + 28, lx + 25, ly + 43,
                                fill='#00ff88', outline='white')
        self.canvas.create_text(lx + 35, ly + 35, text="Binnen klimaat",
                                anchor='w', font=('Arial', 8), fill='#00ff88')

        self.canvas.create_oval(lx + 10, ly + 48, lx + 25, ly + 63,
                                fill='#FFD54F', outline='white')
        self.canvas.create_text(lx + 35, ly + 55, text="Buiten klimaat",
                                anchor='w', font=('Arial', 8), fill='#FFD54F')

        self.canvas.create_line(lx + 10, ly + 73, lx + 25, ly + 73,
                                fill='#ff6bff', width=2, dash=(6, 4))
        self.canvas.create_text(lx + 35, ly + 73, text="Vergelijking",
                                anchor='w', font=('Arial', 8), fill='#ff6bff')

    def on_resize(self, event):
        try:
            self.toon_waarden()
        except Exception:
            pass


