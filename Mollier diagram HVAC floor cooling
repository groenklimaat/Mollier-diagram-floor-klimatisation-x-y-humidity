# VLOERKOELING CONTROLLER
# ============================================================
class VloerkoelingController:
    """
    Regelt vloerkoeling op basis van delta T en dauwpunt-beveiliging.

    - Als T_binnen - T_buiten < 2.0 °C  -> vloerkoeling AAN
    - Aanvoertemperatuur = dauwpunt_binnen + marge - 2.0 °C, min 5 °C
    """

    def __init__(self, psych):
        self.psych = psych
        self.aan = False
        self.veiligheidsmarge = 1.5
        self.delta_t_drempel = 2.0
        self.aanvoer_temp = None
        self.reden = ""

    def bereken(self, T_binnen, phi_binnen, T_buiten, phi_buiten):
        T_dauw_binnen = self.psych.dauwpunt_uit_T_phi(T_binnen, phi_binnen)
        if T_dauw_binnen is None:
            return {'aan': False, 'aanvoer_temp': None,
                    'dauwpunt_binnen': None, 'delta_t': None,
                    'reden': 'Dauwpunt kon niet berekend worden',
                    'waarschuwing': None}

        delta_t = T_binnen - T_buiten
        T_vloer_min = T_dauw_binnen + self.veiligheidsmarge
        T_aanvoer = T_vloer_min - 2.0

        waarschuwing = None
        if T_aanvoer < 5.0:
            T_aanvoer = 5.0
            waarschuwing = ("Aanvoertemperatuur begrensd op 5 °C "
                            "(vorstbeveiliging / COP-bescherming)")

        if delta_t < self.delta_t_drempel:
            self.aan = True
            self.aanvoer_temp = T_aanvoer
            self.reden = (f"Delta T = {delta_t:.2f} °C < {self.delta_t_drempel} °C "
                          f"-> passieve koeling onvoldoende, vloerkoeling AAN")
        else:
            self.aan = False
            self.aanvoer_temp = None
            self.reden = (f"Delta T = {delta_t:.2f} °C >= {self.delta_t_drempel} °C "
                          f"-> nachtventilatie volstaat, vloerkoeling UIT")

        return {
            'aan': self.aan,
            'aanvoer_temp': self.aanvoer_temp,
            'dauwpunt_binnen': T_dauw_binnen,
            'vloer_min': T_vloer_min,
            'delta_t': delta_t,
            'reden': self.reden,
            'waarschuwing': waarschuwing
        }

    def stuur_arduino(self, ser, resultaat):
        if ser is None or not ser.is_open:
            return False
        try:
            if resultaat['aan'] and resultaat['aanvoer_temp'] is not None:
                cmd = f"C,1,{resultaat['aanvoer_temp']:.1f}\n"
            else:
                cmd = "C,0,0\n"
            ser.write(cmd.encode('utf-8'))
            return True
        except Exception as e:
            print(f"Fout bij sturen Arduino: {e}")
            return False


