# PSYCHROMETRIE
# ============================================================
class Psychrometrie:
    """Psychrometrische berekeningen met condensatie en gevoelstemperatuur."""

    def __init__(self, p_atm=101325):
        self.p_atm = p_atm
        self.c_pa = 1.006
        self.h_we = 2501
        self.c_pv = 1.86
        self.R_lucht = 287.05

    def p_sat(self, T):
        return 610.78 * math.exp(17.27 * T / (T + 237.3))

    def x_uit_pv(self, p_v):
        return 0.62198 * p_v / (self.p_atm - p_v)

    def enthalpie(self, T, x):
        return self.c_pa * T + x * (self.h_we + self.c_pv * T)

    def dauwpunt(self, p_v):
        if p_v <= 0:
            return None
        try:
            return (237.3 * math.log(p_v / 610.78)) / (17.27 - math.log(p_v / 610.78))
        except Exception:
            return None

    def dauwpunt_uit_T_phi(self, T, phi):
        p_v = (phi / 100.0) * self.p_sat(T)
        return self.dauwpunt(p_v)

    def natte_bol_temperatuur(self, T, phi):
        p_v = (phi / 100.0) * self.p_sat(T)
        x = self.x_uit_pv(p_v)
        h = self.enthalpie(T, x)
        Twb = T - 5
        for _ in range(50):
            p_sat_wb = self.p_sat(Twb)
            x_wb = self.x_uit_pv(p_sat_wb)
            h_wb = self.enthalpie(Twb, x_wb)
            delta_h = h - h_wb
            if abs(delta_h) < 0.001:
                break
            Twb = Twb + delta_h / 4.0
            if Twb < -10:
                Twb = -10
                break
        return Twb

    def dichtheid(self, T, x):
        T_K = T + 273.15
        p_v = x * self.p_atm / (0.62198 + x)
        p_droog = self.p_atm - p_v
        return (p_droog / (self.R_lucht * T_K)) * (1 + x)

    # ---------------- GEVOELSTEMPERATUUR ----------------

    def heat_index(self, T, phi):
        T_F = T * 9 / 5 + 32
        if T_F < 80:
            return T
        HI_F = (-42.379
                + 2.04901523 * T_F
                + 10.14333127 * phi
                - 0.22475541 * T_F * phi
                - 0.00683783 * T_F ** 2
                - 0.05481717 * phi ** 2
                + 0.00122874 * T_F ** 2 * phi
                + 0.00085282 * T_F * phi ** 2
                - 0.00000199 * T_F ** 2 * phi ** 2)
        if phi < 13 and 80 <= T_F <= 112:
            HI_F -= ((13 - phi) / 4) * math.sqrt((17 - abs(T_F - 95)) / 17)
        if phi > 85 and 80 <= T_F <= 87:
            HI_F += ((phi - 85) / 10) * ((87 - T_F) / 5)
        return (HI_F - 32) * 5 / 9

    def wind_chill(self, T, wind_speed_kmh):
        if T > 10 or wind_speed_kmh < 4.8:
            return T
        return (13.12 + 0.6215 * T
                - 11.37 * (wind_speed_kmh ** 0.16)
                + 0.3965 * T * (wind_speed_kmh ** 0.16))

    def humidex(self, T, T_dauw):
        if T_dauw is None:
            return T
        e = 6.11 * math.exp(5417.7530 * (1 / 273.16 - 1 / (T_dauw + 273.15)))
        return T + 0.5555 * (e - 10)

    def apparent_temperature(self, T, phi, wind_speed_ms=0, solar_radiation=0):
        e = (phi / 100.0) * 6.105 * math.exp(17.27 * T / (237.7 + T))
        AT = T + 0.33 * e - 0.70 * wind_speed_ms - 4.00
        if solar_radiation > 0:
            AT += 0.0042 * solar_radiation
        return AT

    def gevoelstemperatuur_binnen(self, T, phi):
        T_dauw = self.dauwpunt_uit_T_phi(T, phi)
        hx = self.humidex(T, T_dauw)
        at = self.apparent_temperature(T, phi, 0, 0)
        if T >= 20:
            gevoel = 0.5 * hx + 0.5 * at
            methode = "Humidex + Apparent Temp (binnen)"
        else:
            gevoel = T
            methode = "Geen (comfortabel)"
        return {'gevoel': gevoel, 'humidex': hx, 'apparent': at,
                'T_dauw': T_dauw, 'methode': methode}

    def gevoelstemperatuur_buiten(self, T, phi, wind_speed_kmh=5, solar_radiation=0):
        wind_speed_ms = wind_speed_kmh / 3.6
        T_dauw = self.dauwpunt_uit_T_phi(T, phi)
        if T >= 27:
            hi = self.heat_index(T, phi)
            at = self.apparent_temperature(T, phi, wind_speed_ms, solar_radiation)
            gevoel = 0.4 * hi + 0.6 * at
            methode = "Heat Index + Apparent Temp (warm)"
        elif T <= 10 and wind_speed_kmh > 4.8:
            wc = self.wind_chill(T, wind_speed_kmh)
            at = self.apparent_temperature(T, phi, wind_speed_ms, solar_radiation)
            gevoel = 0.6 * wc + 0.4 * at
            methode = "Wind Chill + Apparent Temp (koud)"
        else:
            at = self.apparent_temperature(T, phi, wind_speed_ms, solar_radiation)
            gevoel = at
            methode = "Apparent Temperature"
        return {
            'gevoel': gevoel,
            'heat_index': self.heat_index(T, phi),
            'wind_chill': self.wind_chill(T, wind_speed_kmh),
            'apparent': self.apparent_temperature(T, phi, wind_speed_ms, solar_radiation),
            'humidex': self.humidex(T, T_dauw),
            'T_dauw': T_dauw,
            'wind_speed': wind_speed_kmh,
            'solar_radiation': solar_radiation,
            'methode': methode
        }

    def condensatie_hoeveelheid(self, V_dot, T_in, phi_in, T_oppervlak):
        T_dauw = self.dauwpunt_uit_T_phi(T_in, phi_in)
        if T_dauw is None or T_oppervlak >= T_dauw:
            return 0, T_dauw, False
        p_v_in = (phi_in / 100.0) * self.p_sat(T_in)
        x_in = self.x_uit_pv(p_v_in)
        rho_in = self.dichtheid(T_in, x_in)
        m_dot_lucht = rho_in * V_dot
        p_v_opp = self.p_sat(T_oppervlak)
        x_opp = self.x_uit_pv(p_v_opp)
        m_dot_condens = m_dot_lucht * (x_in - x_opp)
        if m_dot_condens < 0:
            m_dot_condens = 0
        return m_dot_condens, T_dauw, True

    def alle_grootheden(self, T, phi, V_dot=300, wind_speed=5, solar=0):
        p_v = (phi / 100.0) * self.p_sat(T)
        x = self.x_uit_pv(p_v)
        h = self.enthalpie(T, x)
        T_d = self.dauwpunt(p_v)
        T_wb = self.natte_bol_temperatuur(T, phi)
        rho = self.dichtheid(T, x)
        m_dot_lucht = rho * V_dot
        m_dot_water = m_dot_lucht * x
        gevoel_binnen = self.gevoelstemperatuur_binnen(T, phi)
        gevoel_buiten = self.gevoelstemperatuur_buiten(T, phi, wind_speed, solar)
        return {
            'T': T, 'phi': phi, 'p_v': p_v, 'x': x, 'h': h,
            'T_dauw': T_d, 'T_wb': T_wb, 'rho': rho,
            'V_dot': V_dot, 'm_dot_lucht': m_dot_lucht, 'm_dot_water': m_dot_water,
            'gevoel_binnen': gevoel_binnen, 'gevoel_buiten': gevoel_buiten
        }


