# FLOOR COOLING CONTROLLER
# ============================================================
class FloorCoolingController:
    """
    Controls floor cooling based on delta T and dew point protection.

    - If T_indoor - T_outdoor < 2.0 C  -> floor cooling ON
    - Supply temperature = indoor dew point + margin - 2.0 C, min 5 C
    """

    def __init__(self, psych):
        self.psych = psych
        self.on = False
        self.safety_margin = 1.5
        self.delta_t_threshold = 2.0
        self.supply_temp = None
        self.reason = ""

    def calculate(self, T_indoor, rh_indoor, T_outdoor, rh_outdoor):
        T_dew_indoor = self.psych.dew_point_from_T_rh(T_indoor, rh_indoor)
        if T_dew_indoor is None:
            return {'on': False, 'supply_temp': None,
                    'dew_point_indoor': None, 'delta_t': None,
                    'reason': 'Dew point could not be calculated',
                    'warning': None}

        delta_t = T_indoor - T_outdoor
        T_floor_min = T_dew_indoor + self.safety_margin
        T_supply = T_floor_min - 2.0

        warning = None
        if T_supply < 5.0:
            T_supply = 5.0
            warning = ("Supply temperature limited to 5 C "
                       "(frost protection / COP protection)")

        if delta_t < self.delta_t_threshold:
            self.on = True
            self.supply_temp = T_supply
            self.reason = (f"Delta T = {delta_t:.2f} C < {self.delta_t_threshold} C "
                           f"-> passive cooling insufficient, floor cooling ON")
        else:
            self.on = False
            self.supply_temp = None
            self.reason = (f"Delta T = {delta_t:.2f} C >= {self.delta_t_threshold} C "
                           f"-> night ventilation sufficient, floor cooling OFF")

        return {
            'on': self.on,
            'supply_temp': self.supply_temp,
            'dew_point_indoor': T_dew_indoor,
            'floor_min': T_floor_min,
            'delta_t': delta_t,
            'reason': self.reason,
            'warning': warning
        }

    def send_to_arduino(self, ser, result):
        if ser is None or not ser.is_open:
            return False
        try:
            if result['on'] and result['supply_temp'] is not None:
                cmd = f"C,1,{result['supply_temp']:.1f}\n"
            else:
                cmd = "C,0,0\n"
            ser.write(cmd.encode('utf-8'))
            return True
        except Exception as e:
            print(f"Error sending to Arduino: {e}")
            return False


