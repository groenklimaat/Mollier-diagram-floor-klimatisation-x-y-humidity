                 f"{fc['supply_temp']:.1f}"
                 if (fc and fc.get('supply_temp')) else '--', '', 'C'),
                ('Indoor dew point',
                 f"{fc['dew_point_indoor']:.1f}"
                 if (fc and fc.get('dew_point_indoor')) else '--', '', 'C'),
            ]

            for row in rows:
                item = self.result_tree.insert('', tk.END, values=row)
                if '---' in row[0]:
                    self.result_tree.tag_configure('header',
                                                   background='#2d1b4e',
                                                   foreground='#ffd700')
                    self.result_tree.item(item, tags=('header',))
                elif 'FEELS-LIKE' in row[0]:
                    self.result_tree.tag_configure('feels',
                                                   background='#1f3d2f',
                                                   foreground='#00ff88')
                    self.result_tree.item(item, tags=('feels',))
                elif 'FLOOR COOLING' in row[0] or 'Supply' in row[0]:
                    self.result_tree.tag_configure('fc',
                                                   background='#2a1a3a',
                                                   foreground='#00d2ff')
                    self.result_tree.item(item, tags=('fc',))

            self.update_indoor_info(res_in, T_in, rh_in)
            self.update_outdoor_info(res_out, T_out, rh_out, wind, solar)

            self.status_var.set(
                f"Indoor: {T_in:.1f} C (feels "
                f"{res_in['feels_indoor']['feels']:.1f} C) | "
                f"Outdoor: {T_out:.1f} C (feels "
                f"{res_out['feels_outdoor']['feels']:.1f} C) | "
                f"Delta T = {T_in - T_out:+.2f} C"
            )

            self.draw_chart(res_in, res_out, T_in, T_out, rh_in, rh_out)

        except ValueError as e:
            messagebox.showerror("Error", f"Please enter valid numeric values.\n{str(e)}")
        except Exception as e:
            messagebox.showerror("Error", f"Error: {str(e)}")

    def update_indoor_info(self, res, T, rh):
        f = res['feels_indoor']
        lines = [
            f"Temperature: {T:.1f} C",
            f"Humidity: {rh:.0f}%",
            f"Dew point: {f['T_dew']:.1f} C",
            "",
            f"FEELS-LIKE TEMPERATURE: {f['feels']:.1f} C",
            f"   Humidex: {f['humidex']:.1f} C",
            f"   Apparent Temp: {f['apparent']:.1f} C",
            f"   Method: {f['method']}",
            "",
            "Indoor climate is constant:",
        ]
        if T < 18:
            lines.append("   Too cold - increase heating")
        elif T > 26:
            lines.append("   Too warm - increase ventilation")
        elif 20 <= T <= 24 and 40 <= rh <= 60:
            lines.append("   Comfortable indoor climate")
        else:
            lines.append("   Acceptable indoor climate")
        self.indoor_status.config(text="\n".join(lines))

    def update_outdoor_info(self, res, T, rh, wind, solar):
        f = res['feels_outdoor']
        lines = [
            f"Temperature: {T:.1f} C",
            f"Humidity: {rh:.0f}%",
            f"Dew point: {f['T_dew']:.1f} C",
            f"Wind: {wind:.0f} km/h",
            f"Sun: {solar:.0f} W/m2",
            "",
            f"FEELS-LIKE TEMPERATURE: {f['feels']:.1f} C",
            f"   Heat Index: {f['heat_index']:.1f} C",
            f"   Wind Chill: {f['wind_chill']:.1f} C",
            f"   Apparent Temp: {f['apparent']:.1f} C",
            f"   Humidex: {f['humidex']:.1f} C",
            f"   Method: {f['method']}",
            "",
        ]
        diff = f['feels'] - T
        if diff > 3:
            lines.append(f"Feels {diff:.1f} C WARMER")
            lines.append("   High humidity / little wind")
        elif diff < -3:
            lines.append(f"Feels {abs(diff):.1f} C COLDER")
            lines.append("   Wind chill effect / little sun")
        else:
            lines.append("Feels about the same")
        self.outdoor_status.config(text="\n".join(lines))

    def draw_chart(self, res_in, res_out, T_in, T_out, rh_in, rh_out):
        self.canvas.delete("all")
        width = self.canvas.winfo_width()
        height = self.canvas.winfo_height()
        if width < 10 or height < 10:
            return

        margin = 60
        plot_width = width - 2 * margin
        plot_height = height - 2 * margin

        self.canvas.create_rectangle(0, 0, width, height, fill='#0a0a1a')
        self.canvas.create_line(margin, margin, margin, height - margin,
                                width=3, fill='#00d2ff')
        self.canvas.create_line(margin, height - margin, width - margin,
                                height - margin, width=3, fill='#00d2ff')

        self.canvas.create_text(margin - 15, height // 2, text="h (kJ/kg)",
                                angle=90, font=('Arial', 10, 'bold'),
                                fill='#00d2ff')
        self.canvas.create_text(width // 2, height - margin + 25,
                                text="Moisture content x (kg/kg)",
                                font=('Arial', 10, 'bold'), fill='#00d2ff')
        self.canvas.create_text(width // 2, margin - 20,
                                text="INDOOR vs OUTDOOR CLIMATE",
                                font=('Arial', 12, 'bold'), fill='#ffd700')

        x_max = 0.035
        h_max = 120
        x_scale = plot_width / x_max
        h_scale = plot_height / h_max * 0.9

        # Saturation line
        for temp in range(-10, 51, 1):
            try:
                p_sat = self.psych.p_sat(temp)
                x = self.psych.x_from_pv(p_sat)
                h = self.psych.enthalpy(temp, x)
                if 0 <= x <= x_max and 0 <= h <= h_max and temp > -10:
                    p_sat_p = self.psych.p_sat(temp - 1)
                    x_p = self.psych.x_from_pv(p_sat_p)
                    h_p = self.psych.enthalpy(temp - 1, x_p)
                    if 0 <= x_p <= x_max and 0 <= h_p <= h_max:
                        px1 = margin + x_p * x_scale
                        py1 = height - margin - h_p * h_scale
                        px2 = margin + x * x_scale
                        py2 = height - margin - h * h_scale
                        self.canvas.create_line(px1, py1, px2, py2,
                                                fill='#e94560', width=3)
            except Exception:
                continue

        # RH lines
        for rh_val in [20, 40, 60, 80]:
            for temp in range(-10, 51, 2):
                try:
                    p_sat = self.psych.p_sat(temp)
                    p_v = (rh_val / 100.0) * p_sat
                    x = self.psych.x_from_pv(p_v)
                    h = self.psych.enthalpy(temp, x)
                    if 0 <= x <= x_max and 0 <= h <= h_max:
                        p_sat_p = self.psych.p_sat(temp - 2)
                        p_v_p = (rh_val / 100.0) * p_sat_p
                        x_p = self.psych.x_from_pv(p_v_p)
                        h_p = self.psych.enthalpy(temp - 2, x_p)
                        if 0 <= x_p <= x_max and 0 <= h_p <= h_max:
                            px1 = margin + x_p * x_scale
                            py1 = height - margin - h_p * h_scale
                            px2 = margin + x * x_scale
                            py2 = height - margin - h * h_scale
                            self.canvas.create_line(px1, py1, px2, py2,
                                                    fill='#3498db', width=1,
                                                    dash=(3, 3))
                except Exception:
                    continue

        # Indoor point
        if 0 <= res_in['x'] <= x_max and 0 <= res_in['h'] <= h_max:
            px = margin + res_in['x'] * x_scale
            py = height - margin - res_in['h'] * h_scale
            self.canvas.create_oval(px - 10, py - 10, px + 10, py + 10,
                                    fill='#00ff88', outline='white', width=2)
            self.canvas.create_rectangle(px + 15, py - 40, px + 175, py + 10,
                                         fill='#1a3a2e', outline='#00ff88')
            self.canvas.create_text(
                px + 20, py - 35,
                text=f"INDOOR\n{res_in['T']:.1f} C, RH={res_in['rh']:.0f}%\n"
                     f"Feels: {res_in['feels_indoor']['feels']:.1f} C",
                anchor='w', font=('Arial', 8), fill='#00ff88')

        # Outdoor point
        if 0 <= res_out['x'] <= x_max and 0 <= res_out['h'] <= h_max:
            px = margin + res_out['x'] * x_scale
            py = height - margin - res_out['h'] * h_scale
            self.canvas.create_oval(px - 10, py - 10, px + 10, py + 10,
                                    fill='#FFD54F', outline='white', width=2)
            self.canvas.create_rectangle(px + 15, py - 40, px + 185, py + 10,
                                         fill='#3a2e1a', outline='#FFD54F')
            self.canvas.create_text(
                px + 20, py - 35,
                text=f"OUTDOOR\n{res_out['T']:.1f} C, RH={res_out['rh']:.0f}%\n"
                     f"Feels: {res_out['feels_outdoor']['feels']:.1f} C",
                anchor='w', font=('Arial', 8), fill='#FFD54F')

        # Connecting line
        if (0 <= res_in['x'] <= x_max and 0 <= res_in['h'] <= h_max and
                0 <= res_out['x'] <= x_max and 0 <= res_out['h'] <= h_max):
            px1 = margin + res_in['x'] * x_scale
            py1 = height - margin - res_in['h'] * h_scale
            px2 = margin + res_out['x'] * x_scale
            py2 = height - margin - res_out['h'] * h_scale
            self.canvas.create_line(px1, py1, px2, py2, fill='#ff6bff',
                                    width=2, dash=(6, 4))

        # Legend
        lx, ly = margin + 10, margin + 10
        self.canvas.create_rectangle(lx, ly, lx + 200, ly + 80,
                                     fill='#1a1a2e', outline='#00d2ff')
        self.canvas.create_text(lx + 10, ly + 15, text="LEGEND", anchor='w',
                                font=('Arial', 9, 'bold'), fill='#ffd700')

        self.canvas.create_oval(lx + 10, ly + 28, lx + 25, ly + 43,
                                fill='#00ff88', outline='white')
        self.canvas.create_text(lx + 35, ly + 35, text="Indoor climate",
                                anchor='w', font=('Arial', 8), fill='#00ff88')

        self.canvas.create_oval(lx + 10, ly + 48, lx + 25, ly + 63,
                                fill='#FFD54F', outline='white')
        self.canvas.create_text(lx + 35, ly + 55, text="Outdoor climate",
                                anchor='w', font=('Arial', 8), fill='#FFD54F')

        self.canvas.create_line(lx + 10, ly + 73, lx + 25, ly + 73,
                                fill='#ff6bff', width=2, dash=(6, 4))
        self.canvas.create_text(lx + 35, ly + 73, text="Comparison",
                                anchor='w', font=('Arial', 8), fill='#ff6bff')

    def on_resize(self, event):
        try:
            self.show_values()
        except Exception:
            pass


