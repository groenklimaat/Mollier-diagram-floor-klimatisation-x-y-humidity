    # --------------------------------------------------------
    # DHT22 / Arduino functions
    # --------------------------------------------------------
    def refresh_ports(self):
        if not SERIAL_AVAILABLE:
            messagebox.showwarning("pyserial not found",
                                   "Install pyserial:\n\npip install pyserial")
            return
        ports = DHT22Reader.list_ports()
        self.port_in_combo['values'] = ports
        self.port_out_combo['values'] = ports
        self.arduino_port_combo['values'] = ports
        if len(ports) >= 1 and not self.port_in_var.get():
            self.port_in_var.set(ports[0])
        if len(ports) >= 2 and not self.port_out_var.get():
            self.port_out_var.set(ports[1])
        if len(ports) >= 1 and not self.arduino_port_var.get():
            self.arduino_port_var.set(ports[0])
        self.status_var.set(f"{len(ports)} port(s) found")

    def toggle_connection(self, location):
        if location == 'indoor':
            if self.dht_indoor_connected:
                self.dht_indoor.disconnect()
                self.dht_indoor_connected = False
                self.connect_in_btn.config(text="CONNECT INDOOR", bg='#00695C')
                self.status_in_var.set("Indoor not connected")
            else:
                self._connect(location)
        else:
            if self.dht_outdoor_connected:
                self.dht_outdoor.disconnect()
                self.dht_outdoor_connected = False
                self.connect_out_btn.config(text="CONNECT OUTDOOR", bg='#00695C')
                self.status_out_var.set("Outdoor not connected")
            else:
                self._connect(location)

    def _connect(self, location):
        if not SERIAL_AVAILABLE:
            messagebox.showerror("Error", "pyserial is not installed.\n\npip install pyserial")
            return
        port = self.port_in_var.get() if location == 'indoor' else self.port_out_var.get()
        if not port:
            messagebox.showwarning("No port", f"Select a port for {location}.")
            return
        try:
            if location == 'indoor':
                self.dht_indoor.connect(port)
                self.dht_indoor_connected = True
                self.connect_in_btn.config(text="DISCONNECT INDOOR", bg='#c62828')
                self.status_in_var.set(f"Indoor: {port}")
                self.dht_indoor.start_reading(self.on_dht_indoor)
            else:
                self.dht_outdoor.connect(port)
                self.dht_outdoor_connected = True
                self.connect_out_btn.config(text="DISCONNECT OUTDOOR", bg='#c62828')
                self.status_out_var.set(f"Outdoor: {port}")
                self.dht_outdoor.start_reading(self.on_dht_outdoor)
            self.status_var.set(f"{location.capitalize()} connected on {port}")
        except Exception as e:
            messagebox.showerror("Connection error", f"Could not connect:\n{str(e)}")

    def on_dht_indoor(self, T, rh):
        self.root.after(0, lambda: self._update_dht_indoor(T, rh))

    def on_dht_outdoor(self, T, rh):
        self.root.after(0, lambda: self._update_dht_outdoor(T, rh))

    def _update_dht_indoor(self, T, rh):
        self.dht_in_temp.set(f"{T:.1f}")
        self.dht_in_rh.set(f"{rh:.0f}")
        if self.control_mode.get() == 'arduino':
            self.temp_in_var.set(f"{T:.1f}")
            self.rh_in_var.set(f"{rh:.0f}")

    def _update_dht_outdoor(self, T, rh):
        self.dht_out_temp.set(f"{T:.1f}")
        self.dht_out_rh.set(f"{rh:.0f}")
        if self.control_mode.get() == 'arduino':
            self.temp_out_var.set(f"{T:.1f}")
            self.rh_out_var.set(f"{rh:.0f}")

    # --------------------------------------------------------
    # Floor cooling
    # --------------------------------------------------------
    def update_control_mode(self):
        mode = self.control_mode.get()
        if mode == 'manual':
            if self.arduino_ser and self.arduino_ser.is_open:
                self.arduino_ser.close()
            self.arduino_ser = None
            self.arduino_connect_btn.config(text="Connect", bg='#00695C')
            self.status_var.set("Manual mode: entered values are used for calculation")
        else:
            self.status_var.set("Arduino mode: sensor values come from Arduino")
        self.show_values()

    def toggle_arduino(self):
        if self.arduino_ser and self.arduino_ser.is_open:
            self.arduino_ser.close()
            self.arduino_ser = None
            self.arduino_connect_btn.config(text="Connect", bg='#00695C')
            self.status_var.set("Arduino control disconnected")
            return
        if not SERIAL_AVAILABLE:
            messagebox.showerror("Error", "pyserial is not installed")
            return
        port = self.arduino_port_var.get()
        if not port:
            messagebox.showwarning("No port", "Select an Arduino port.")
            return
        try:
            self.arduino_ser = serial.Serial(port, 9600, timeout=1)
            time.sleep(2)
            self.arduino_connect_btn.config(text="Disconnect", bg='#c62828')
            self.status_var.set(f"Arduino control connected on {port}")
        except Exception as e:
            messagebox.showerror("Error", f"Could not connect to Arduino:\n{e}")

    def update_floor_cooling(self, T_in, rh_in, T_out, rh_out):
        result = self.floor_cooling.calculate(T_in, rh_in, T_out, rh_out)
        self.floor_cooling_result = result

        if self.override_var.get():
            result['on'] = True
            if result['supply_temp'] is None:
                T_dew = result.get('dew_point_indoor')
                result['supply_temp'] = (T_dew + 1.5 - 2.0) if T_dew else 12.0
            result['reason'] = "MANUALLY FORCED ON"

        if result['on']:
            self.fc_status_var.set(
                f"FLOOR COOLING ON\n"
                f"   Supply temperature: {result['supply_temp']:.1f} C"
            )
            self.fc_status_label.config(fg='#00ff88')
        else:
            self.fc_status_var.set("FLOOR COOLING OFF")
            self.fc_status_label.config(fg='#ff6b6b')

        detail = result['reason']
        if result.get('dew_point_indoor') is not None:
            detail += f"\nIndoor dew point: {result['dew_point_indoor']:.1f} C"
        if 'floor_min' in result:
            detail += f"\nMin. floor temperature: {result['floor_min']:.1f} C"
        if result.get('warning'):
            detail += f"\n{result['warning']}"
        self.fc_detail_var.set(detail)

        if (self.control_mode.get() == 'arduino'
                and self.arduino_ser and self.arduino_ser.is_open):
            self.floor_cooling.send_to_arduino(self.arduino_ser, result)

    def save_arduino_sketch(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".ino",
            filetypes=[("Arduino sketch", "*.ino"), ("All files", "*.*")],
            initialfile="vloerkoeling.ino"
        )
        if path:
            try:
                with open(path, 'w', encoding='utf-8') as f:
                    f.write(ARDUINO_SKETCH)
                messagebox.showinfo("Saved",
                                    f"Arduino sketch saved:\n{path}\n\n"
                                    f"Open this file in the Arduino IDE.")
            except Exception as e:
                messagebox.showerror("Error", f"Could not save:\n{e}")

