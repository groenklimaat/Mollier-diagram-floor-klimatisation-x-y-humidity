# ============================================================
# ARDUINO SKETCH (stored as string so we can save it as .ino)
# ============================================================
ARDUINO_SKETCH = r'''// vloerkoeling.ino
// Arduino floor cooling controller
// Receives over Serial:  C,<0|1>,<supply_temp>\n
//                        S\n  (request status)
// Replies:               ACK\n  or  STATUS,<on>,<temp>\n

#include <OneWire.h>
#include <DallasTemperature.h>

#define ONE_WIRE_BUS 2
#define RELAY_PIN    8
#define LED_PIN      13

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

bool  coolingOn    = false;
float supplyTemp   = 0.0;

void setup() {
  Serial.begin(9600);
  sensors.begin();
  pinMode(RELAY_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW);
  digitalWrite(LED_PIN, LOW);
  Serial.println("READY");
}

void loop() {
  if (Serial.available() > 0) {
    String line = Serial.readStringUntil('\n');
    line.trim();

    if (line.startsWith("C,")) {
      int first  = line.indexOf(',');
      int second = line.indexOf(',', first + 1);
      int on     = line.substring(first + 1, second).toInt();
      float temp = line.substring(second + 1).toFloat();

      if (on == 1) {
        coolingOn  = true;
        supplyTemp = temp;
        digitalWrite(RELAY_PIN, HIGH);
        digitalWrite(LED_PIN, HIGH);
      } else {
        coolingOn = false;
        digitalWrite(RELAY_PIN, LOW);
        digitalWrite(LED_PIN, LOW);
      }
      Serial.println("ACK");
    }
    else if (line == "S") {
      Serial.print("STATUS,");
      Serial.print(coolingOn ? 1 : 0);
      Serial.print(",");
      Serial.println(supplyTemp, 1);
    }
  }

  static unsigned long last = 0;
  if (millis() - last > 5000) {
    last = millis();
    sensors.requestTemperatures();
    float t = sensors.getTempCByIndex(0);
    if (t > -100) {
      Serial.print("T,");
      Serial.println(t, 1);
    }
  }
}
'''


# ============================================================
# PSYCHROMETRICS
# ============================================================
class Psychrometrics:
    """Psychrometric calculations with condensation and feels-like temperature."""

    def __init__(self, p_atm=101325):
        self.p_atm = p_atm
        self.c_pa = 1.006
        self.h_we = 2501
        self.c_pv = 1.86
        self.R_air = 287.05

    def p_sat(self, T):
        return 610.78 * math.exp(17.27 * T / (T + 237.3))

    def x_from_pv(self, p_v):
        return 0.62198 * p_v / (self.p_atm - p_v)

    def enthalpy(self, T, x):
        return self.c_pa * T + x * (self.h_we + self.c_pv * T)

    def dew_point(self, p_v):
        if p_v <= 0:
            return None
        try:
            return (237.3 * math.log(p_v / 610.78)) / (17.27 - math.log(p_v / 610.78))
        except Exception:
            return None

    def dew_point_from_T_rh(self, T, rh):
        p_v = (rh / 100.0) * self.p_sat(T)
        return self.dew_point(p_v)

    def wet_bulb_temperature(self, T, rh):
        p_v = (rh / 100.0) * self.p_sat(T)
        x = self.x_from_pv(p_v)
        h = self.enthalpy(T, x)
        Twb = T - 5
        for _ in range(50):
            p_sat_wb = self.p_sat(Twb)
            x_wb = self.x_from_pv(p_sat_wb)
            h_wb = self.enthalpy(Twb, x_wb)
            delta_h = h - h_wb
            if abs(delta_h) < 0.001:
                break
            Twb = Twb + delta_h / 4.0
            if Twb < -10:
                Twb = -10
                break
        return Twb

    def density(self, T, x):
        T_K = T + 273.15
        p_v = x * self.p_atm / (0.62198 + x)
        p_dry = self.p_atm - p_v
        return (p_dry / (self.R_air * T_K)) * (1 + x)

    # ---------------- FEELS-LIKE TEMPERATURE ----------------

    def heat_index(self, T, rh):
        T_F = T * 9 / 5 + 32
        if T_F < 80:
            return T
        HI_F = (-42.379
                + 2.04901523 * T_F
                + 10.14333127 * rh
                - 0.22475541 * T_F * rh
                - 0.00683783 * T_F ** 2
                - 0.05481717 * rh ** 2
                + 0.00122874 * T_F ** 2 * rh
                + 0.00085282 * T_F * rh ** 2
                - 0.00000199 * T_F ** 2 * rh ** 2)
        if rh < 13 and 80 <= T_F <= 112:
            HI_F -= ((13 - rh) / 4) * math.sqrt((17 - abs(T_F - 95)) / 17)
        if rh > 85 and 80 <= T_F <= 87:
            HI_F += ((rh - 85) / 10) * ((87 - T_F) / 5)
        return (HI_F - 32) * 5 / 9

    def wind_chill(self, T, wind_speed_kmh):
        if T > 10 or wind_speed_kmh < 4.8:
            return T
        return (13.12 + 0.6215 * T
                - 11.37 * (wind_speed_kmh ** 0.16)
                + 0.3965 * T * (wind_speed_kmh ** 0.16))

    def humidex(self, T, T_dew):
        if T_dew is None:
            return T
        e = 6.11 * math.exp(5417.7530 * (1 / 273.16 - 1 / (T_dew + 273.15)))
        return T + 0.5555 * (e - 10)

    def apparent_temperature(self, T, rh, wind_speed_ms=0, solar_radiation=0):
        e = (rh / 100.0) * 6.105 * math.exp(17.27 * T / (237.7 + T))
        AT = T + 0.33 * e - 0.70 * wind_speed_ms - 4.00
        if solar_radiation > 0:
            AT += 0.0042 * solar_radiation
        return AT

    def feels_like_indoor(self, T, rh):
        T_dew = self.dew_point_from_T_rh(T, rh)
        hx = self.humidex(T, T_dew)
        at = self.apparent_temperature(T, rh, 0, 0)
        if T >= 20:
            feels = 0.5 * hx + 0.5 * at
            method = "Humidex + Apparent Temp (indoor)"
        else:
            feels = T
            method = "None (comfortable)"
        return {'feels': feels, 'humidex': hx, 'apparent': at,
                'T_dew': T_dew, 'method': method}

    def feels_like_outdoor(self, T, rh, wind_speed_kmh=5, solar_radiation=0):
        wind_speed_ms = wind_speed_kmh / 3.6
        T_dew = self.dew_point_from_T_rh(T, rh)
        if T >= 27:
            hi = self.heat_index(T, rh)
            at = self.apparent_temperature(T, rh, wind_speed_ms, solar_radiation)
            feels = 0.4 * hi + 0.6 * at
            method = "Heat Index + Apparent Temp (warm)"
        elif T <= 10 and wind_speed_kmh > 4.8:
            wc = self.wind_chill(T, wind_speed_kmh)
            at = self.apparent_temperature(T, rh, wind_speed_ms, solar_radiation)
            feels = 0.6 * wc + 0.4 * at
            method = "Wind Chill + Apparent Temp (cold)"
        else:
            at = self.apparent_temperature(T, rh, wind_speed_ms, solar_radiation)
            feels = at
            method = "Apparent Temperature"
        return {
            'feels': feels,
            'heat_index': self.heat_index(T, rh),
            'wind_chill': self.wind_chill(T, wind_speed_kmh),
            'apparent': self.apparent_temperature(T, rh, wind_speed_ms, solar_radiation),
            'humidex': self.humidex(T, T_dew),
            'T_dew': T_dew,
            'wind_speed': wind_speed_kmh,
            'solar_radiation': solar_radiation,
            'method': method
        }

    def condensation_amount(self, V_dot, T_in, rh_in, T_surface):
        T_dew = self.dew_point_from_T_rh(T_in, rh_in)
        if T_dew is None or T_surface >= T_dew:
            return 0, T_dew, False
        p_v_in = (rh_in / 100.0) * self.p_sat(T_in)
        x_in = self.x_from_pv(p_v_in)
        rho_in = self.density(T_in, x_in)
        m_dot_air = rho_in * V_dot
        p_v_surf = self.p_sat(T_surface)
        x_surf = self.x_from_pv(p_v_surf)
        m_dot_condens = m_dot_air * (x_in - x_surf)
        if m_dot_condens < 0:
            m_dot_condens = 0
        return m_dot_condens, T_dew, True

    def all_quantities(self, T, rh, V_dot=300, wind_speed=5, solar=0):
        p_v = (rh / 100.0) * self.p_sat(T)
        x = self.x_from_pv(p_v)
        h = self.enthalpy(T, x)
        T_d = self.dew_point(p_v)
        T_wb = self.wet_bulb_temperature(T, rh)
        rho = self.density(T, x)
        m_dot_air = rho * V_dot
        m_dot_water = m_dot_air * x
        feels_indoor = self.feels_like_indoor(T, rh)
        feels_outdoor = self.feels_like_outdoor(T, rh, wind_speed, solar)
        return {
            'T': T, 'rh': rh, 'p_v': p_v, 'x': x, 'h': h,
            'T_dew': T_d, 'T_wb': T_wb, 'rho': rho,
            'V_dot': V_dot, 'm_dot_air': m_dot_air, 'm_dot_water': m_dot_water,
            'feels_indoor': feels_indoor, 'feels_outdoor': feels_outdoor
        }


